# LiteLLM Master Key for authentication
# Generate a secure random key: openssl rand -base64 32
LITELLM_MASTER_KEY=sk-1234

# Postgres credentials (used by both the postgres container and DATABASE_URL)
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_password
POSTGRES_DB=litellm

# Note: GitHub Copilot authentication uses an OAuth device code flow.
# On first start, the container will print a URL and one-time code in its logs.
# Open the URL, enter the code, and authorize — no manual token handling needed.
# The token is persisted in the `copilot_tokens` Docker volume and reused on
# subsequent restarts. Re-auth is only needed if the token expires.
# See README.md for details.

# Azure OpenAI - Entra ID auth (required if using azure-* models)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-client-id>
AZURE_CLIENT_SECRET=<your-client-secret>

